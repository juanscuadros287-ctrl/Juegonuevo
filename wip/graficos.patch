diff --git a/shaders/building.gdshader b/shaders/building.gdshader
new file mode 100644
index 0000000..0f8ae40
--- /dev/null
+++ b/shaders/building.gdshader
@@ -0,0 +1,136 @@
+shader_type spatial;
+render_mode cull_back;
+// Material único de edificios y modelos de MeshLib (docs/GRAFICOS.md).
+// COLOR.rgb = color base (con la variación de tono de cada edificio ya aplicada).
+// UV2.x = tipo de material: 0 liso, 1 estuco/adobe, 2 ladrillo, 3 madera, 4 piedra, 5 teja,
+//         6 paja, 7 concreto, 8 metal, 9 vidrio, 10 emisivo (farol).
+// UV2.y = azar por pieza (ventanas encendidas de noche, vetas).
+// Sombreado plano: la normal sale de las derivadas de pantalla (low-poly limpio y consistente).
+// Los patrones son procedurales en espacio del mundo: sin texturas, baratos en un M1 y en OpenGL.
+
+uniform float night : hint_range(0.0, 1.0) = 0.0;
+uniform float detail_fade_start = 70.0;
+uniform float detail_fade_end = 140.0;
+uniform vec3 window_light = vec3(1.0, 0.72, 0.38);
+
+varying vec3 wpos;
+varying vec3 wnrm;
+varying flat vec2 mdata;
+
+float hash21(vec2 p) {
+	p = fract(p * vec2(123.34, 456.21));
+	p += dot(p, p + 45.32);
+	return fract(p.x * p.y);
+}
+
+float vnoise(vec2 p) {
+	vec2 i = floor(p);
+	vec2 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	float a = hash21(i);
+	float b = hash21(i + vec2(1.0, 0.0));
+	float c = hash21(i + vec2(0.0, 1.0));
+	float d = hash21(i + vec2(1.0, 1.0));
+	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
+}
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
+	mdata = UV2;
+}
+
+// Coordenadas 2D sobre la cara según la normal dominante (u horizontal, v vertical).
+vec2 face_uv(vec3 p, vec3 n) {
+	vec3 a = abs(n);
+	if (a.y > 0.7) {
+		return p.xz;
+	}
+	return (a.x > a.z) ? vec2(p.z, p.y) : vec2(p.x, p.y);
+}
+
+void fragment() {
+	vec3 n = normalize(cross(dFdx(VERTEX), dFdy(VERTEX)));
+	if (dot(n, VERTEX) > 0.0) {
+		n = -n;
+	}
+	NORMAL = n;
+	vec3 base = COLOR.rgb;
+	float kind = floor(mdata.x + 0.5);
+	float rnd = mdata.y;
+	float dist = length(VERTEX);
+	// Los patrones se desvanecen con la distancia (evita moiré y parpadeo).
+	float detail = 1.0 - smoothstep(detail_fade_start, detail_fade_end, dist);
+	vec2 uv = face_uv(wpos, normalize(wnrm));
+	float shade = 1.0;
+	float rough = 0.88;
+	float metal = 0.0;
+	float spec = 0.35;
+	vec3 emit = vec3(0.0);
+	if (kind == 1.0) {
+		// Estuco / adobe: manchas suaves.
+		shade = 0.94 + 0.08 * vnoise(uv * 1.3) + 0.04 * vnoise(uv * 6.0);
+	} else if (kind == 2.0) {
+		// Ladrillo: hiladas de 0,22 m y juntas de mortero.
+		vec2 b = uv / vec2(0.46, 0.22);
+		b.x += 0.5 * mod(floor(b.y), 2.0);
+		vec2 f = fract(b);
+		float mortar = step(f.y, 0.1) + step(f.x, 0.05);
+		float tone = 0.9 + 0.18 * hash21(floor(b));
+		shade = mix(tone, 1.25, clamp(mortar, 0.0, 1.0) * 0.6);
+	} else if (kind == 3.0) {
+		// Madera: tablas horizontales de 0,28 m con vetas.
+		float row = floor(uv.y / 0.28);
+		float f = fract(uv.y / 0.28);
+		shade = 0.86 + 0.16 * hash21(vec2(row, rnd * 17.0)) + 0.05 * vnoise(vec2(uv.x * 3.0, row * 7.0));
+		shade *= mix(0.72, 1.0, smoothstep(0.0, 0.08, f));
+	} else if (kind == 4.0) {
+		// Piedra: bloques irregulares.
+		vec2 b = uv / vec2(0.7, 0.4);
+		b.x += 0.37 * mod(floor(b.y), 3.0);
+		vec2 f = fract(b);
+		float joint = step(f.y, 0.08) + step(f.x, 0.05);
+		shade = mix(0.82 + 0.26 * hash21(floor(b)), 0.62, clamp(joint, 0.0, 1.0));
+		shade *= 0.95 + 0.1 * vnoise(uv * 4.0);
+	} else if (kind == 5.0) {
+		// Teja: hileras onduladas a lo largo de la pendiente.
+		float row = floor(wpos.y / 0.24);
+		float f = fract(wpos.y / 0.24);
+		float along = (abs(wnrm.x) > abs(wnrm.z)) ? wpos.z : wpos.x;
+		float wave = 0.5 + 0.5 * sin(along * 20.0);
+		shade = (0.84 + 0.12 * wave + 0.08 * hash21(vec2(row, floor(along * 3.2)))) * mix(0.7, 1.0, smoothstep(0.0, 0.2, f));
+	} else if (kind == 6.0) {
+		// Paja: fibras.
+		float along = (abs(wnrm.x) > abs(wnrm.z)) ? wpos.z : wpos.x;
+		shade = 0.84 + 0.2 * vnoise(vec2(along * 14.0, wpos.y * 1.5)) + 0.06 * vnoise(vec2(along * 40.0, wpos.y * 3.0));
+		shade *= mix(0.78, 1.0, smoothstep(0.0, 0.25, fract(wpos.y / 0.45)));
+	} else if (kind == 7.0) {
+		// Concreto: paneles grandes.
+		vec2 f = fract(uv / vec2(3.0, 1.5));
+		float joint = step(f.y, 0.02) + step(f.x, 0.01);
+		shade = (0.93 + 0.07 * vnoise(uv * 2.0)) * mix(1.0, 0.8, clamp(joint, 0.0, 1.0));
+	} else if (kind == 8.0) {
+		// Metal corrugado.
+		shade = 0.88 + 0.12 * sin(uv.x * 30.0);
+		rough = 0.45;
+		metal = 0.35;
+		spec = 0.6;
+	} else if (kind == 9.0) {
+		// Vidrio: brillante; de noche algunas ventanas se encienden (según el azar de la pieza).
+		rough = 0.12;
+		metal = 0.25;
+		spec = 0.8;
+		float lit = step(0.35, fract(rnd * 7.31 + floor(wpos.y / 2.6) * 0.37 + floor((wpos.x + wpos.z) / 2.2) * 0.23));
+		emit = window_light * lit * night * 1.6;
+		base = mix(base, base * 0.35, night * lit);
+	} else if (kind == 10.0) {
+		rough = 0.5;
+		emit = base * (0.25 + night * 3.0);
+	}
+	shade = mix(1.0, shade, detail);
+	ALBEDO = base * shade;
+	ROUGHNESS = rough;
+	METALLIC = metal;
+	SPECULAR = spec;
+	EMISSION = emit;
+}
diff --git a/shaders/foliage.gdshader b/shaders/foliage.gdshader
new file mode 100644
index 0000000..defc94a
--- /dev/null
+++ b/shaders/foliage.gdshader
@@ -0,0 +1,38 @@
+shader_type spatial;
+render_mode cull_disabled;
+// Vegetación y rocas con color por instancia/vértice (docs/GRAFICOS.md).
+// Balanceo con el viento barato: solo se mueven los vértices altos de las piezas verdes
+// (copas, hojas, pasto); troncos marrones y rocas grises quedan quietos.
+// Sombreado plano con normales de derivadas de pantalla (low-poly limpio).
+
+uniform float wind_strength = 0.12;
+uniform float wind_speed = 1.3;
+uniform vec2 wind_dir = vec2(0.8, 0.6);
+
+varying float sway_w;
+
+void vertex() {
+	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	vec3 origin = MODEL_MATRIX[3].xyz;
+	float green = clamp((COLOR.g - max(COLOR.r, COLOR.b)) * 6.0, 0.0, 1.0);
+	float hgt = max(wp.y - origin.y, 0.0);
+	float phase = dot(origin.xz, vec2(0.13, 0.17));
+	float s = sin(TIME * wind_speed + phase) * 0.7 + sin(TIME * wind_speed * 2.3 + phase * 1.7) * 0.3;
+	vec2 off = wind_dir * s * wind_strength * hgt * 0.35 * green;
+	// Desplazamiento en espacio del mundo convertido al espacio local del modelo.
+	float sc2 = max(dot(MODEL_MATRIX[0].xyz, MODEL_MATRIX[0].xyz), 0.0001);
+	vec3 local_off = (vec4(off.x, 0.0, off.y, 0.0) * MODEL_MATRIX).xyz / sc2;
+	VERTEX += local_off;
+}
+
+void fragment() {
+	vec3 n = normalize(cross(dFdx(VERTEX), dFdy(VERTEX)));
+	if (dot(n, VERTEX) > 0.0) {
+		n = -n;
+	}
+	NORMAL = n;
+	ALBEDO = COLOR.rgb;
+	ROUGHNESS = 0.92;
+	SPECULAR = 0.25;
+	BACKLIGHT = COLOR.rgb * 0.25;
+}
diff --git a/shaders/road.gdshader b/shaders/road.gdshader
new file mode 100644
index 0000000..97e2eae
--- /dev/null
+++ b/shaders/road.gdshader
@@ -0,0 +1,96 @@
+shader_type spatial;
+render_mode skip_vertex_transform, cull_disabled;
+// Carreteras, caminos, balasto y rieles (docs/GRAFICOS.md). Patrones procedurales sin texturas:
+// kind 0 = tierra con huellas, 1 = empedrado, 2 = asfalto con líneas, 3 = balasto (grava),
+// 4 = acero de riel, 5 = tablero de madera (puentes).
+// UV.x = 0..1 a lo ancho, UV.y = metros a lo largo. Los patrones "de superficie" usan coordenadas
+// del mundo: dos tramos que se cruzan dibujan exactamente lo mismo (intersecciones sin parpadeo).
+// El vértice se acerca un poco a la cámara (sesgo de profundidad) para no pelear con el terreno.
+
+uniform int kind = 0;
+uniform vec3 base_color : source_color = vec3(0.5, 0.4, 0.3);
+uniform float depth_bias = 0.04;
+uniform float detail_fade = 120.0;
+
+varying vec3 wpos;
+
+float hash21(vec2 p) {
+	p = fract(p * vec2(123.34, 456.21));
+	p += dot(p, p + 45.32);
+	return fract(p.x * p.y);
+}
+
+float vnoise(vec2 p) {
+	vec2 i = floor(p);
+	vec2 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
+}
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	float d = length(VERTEX);
+	VERTEX -= VERTEX / max(d, 0.001) * min(depth_bias + d * 0.0022, 4.0);
+	NORMAL = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
+}
+
+void fragment() {
+	float dist = length(VERTEX);
+	float detail = 1.0 - smoothstep(detail_fade * 0.5, detail_fade, dist);
+	vec2 w = wpos.xz;
+	float u = UV.x;
+	float along = UV.y;
+	vec3 c = base_color;
+	float rough = 0.95;
+	float metal = 0.0;
+	float edge = smoothstep(0.0, 0.1, u) * smoothstep(1.0, 0.9, u);
+	if (kind == 0) {
+		// Tierra apisonada: manchas, huellas de ruedas y bordes con pasto.
+		float n = vnoise(w * 1.6) * 0.6 + vnoise(w * 5.0) * 0.4;
+		float ruts = exp(-pow((u - 0.3) / 0.06, 2.0)) + exp(-pow((u - 0.7) / 0.06, 2.0));
+		c *= 0.86 + 0.24 * n;
+		c *= 1.0 - 0.2 * ruts * detail;
+		c = mix(vec3(0.3, 0.42, 0.2) * (0.85 + 0.3 * n), c, smoothstep(0.0, 0.16, min(u, 1.0 - u) + (n - 0.5) * 0.12));
+	} else if (kind == 1) {
+		// Empedrado: piedras en hileras desfasadas, juntas oscuras y bordillo.
+		vec2 p = w / 0.36;
+		p.x += 0.5 * mod(floor(p.y), 2.0);
+		vec2 f = fract(p) - 0.5;
+		float stone = hash21(floor(p));
+		float joint = smoothstep(0.36, 0.48, max(abs(f.x), abs(f.y)));
+		c *= (0.8 + 0.35 * stone) * mix(1.0, 0.55, joint * detail);
+		float curb = 1.0 - step(0.07, u) * step(u, 0.93);
+		c = mix(c, base_color * 1.25, curb);
+		rough = 0.85;
+	} else if (kind == 2) {
+		// Asfalto: grano fino, bordes blancos y línea central amarilla discontinua.
+		float n = vnoise(w * 3.0) * 0.5 + vnoise(w * 11.0) * 0.5;
+		c *= 0.88 + 0.2 * n;
+		float side = step(0.055, u) * step(u, 0.095) + step(0.905, u) * step(u, 0.945);
+		float center = step(abs(u - 0.5), 0.022) * step(fract(along / 4.0), 0.55);
+		c = mix(c, vec3(0.92, 0.92, 0.88), side * 0.9);
+		c = mix(c, vec3(0.95, 0.78, 0.25), center * 0.95);
+		float shoulder = 1.0 - step(0.03, u) * step(u, 0.97);
+		c = mix(c, base_color * 1.4, shoulder);
+		rough = 0.8;
+	} else if (kind == 3) {
+		// Balasto: grava.
+		float g = hash21(floor(w / 0.12)) * 0.6 + vnoise(w * 2.5) * 0.4;
+		c *= 0.75 + 0.45 * g;
+	} else if (kind == 4) {
+		c = base_color;
+		rough = 0.35;
+		metal = 0.7;
+	} else if (kind == 5) {
+		// Tablones de madera cruzados.
+		float plank = fract(along / 0.35);
+		c *= (0.82 + 0.25 * hash21(vec2(floor(along / 0.35), 3.0))) * mix(0.65, 1.0, smoothstep(0.0, 0.12, plank));
+		rough = 0.9;
+	}
+	c = mix(base_color, c, 0.35 + 0.65 * detail);
+	ALBEDO = c;
+	ROUGHNESS = rough;
+	METALLIC = metal;
+	SPECULAR = 0.3;
+}
diff --git a/shaders/water.gdshader b/shaders/water.gdshader
new file mode 100644
index 0000000..4b41313
--- /dev/null
+++ b/shaders/water.gdshader
@@ -0,0 +1,70 @@
+shader_type spatial;
+render_mode blend_mix, depth_draw_opaque, cull_disabled, specular_schlick_ggx;
+// Agua de ríos, lagos y mar (docs/GRAFICOS.md). Sin textura de profundidad (funciona igual en
+// Forward+ y en Compatibility): la profundidad sale de un mapa de alturas del terreno horneado
+// alrededor del pueblo (height_tex). Color por profundidad, brillo con fresnel, ondas suaves en la
+// normal y espuma animada en la orilla.
+
+uniform sampler2D height_tex : filter_linear, repeat_disable;
+uniform vec4 height_rect = vec4(-200.0, -200.0, 400.0, 400.0);   // x0, z0, ancho, alto
+uniform float water_level = 0.0;
+uniform float far_depth = 4.0;
+uniform vec3 shallow_color : source_color = vec3(0.22, 0.58, 0.6);
+uniform vec3 deep_color : source_color = vec3(0.05, 0.2, 0.36);
+uniform vec3 foam_color : source_color = vec3(0.92, 0.96, 0.98);
+uniform float wave_scale = 0.18;
+
+varying vec3 wpos;
+
+float hash21(vec2 p) {
+	p = fract(p * vec2(123.34, 456.21));
+	p += dot(p, p + 45.32);
+	return fract(p.x * p.y);
+}
+
+float vnoise(vec2 p) {
+	vec2 i = floor(p);
+	vec2 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
+}
+
+float waves(vec2 p, float t) {
+	return vnoise(p * 0.35 + vec2(t * 0.25, t * 0.12)) * 0.6 + vnoise(p * 0.9 - vec2(t * 0.18, -t * 0.3)) * 0.4;
+}
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+}
+
+void fragment() {
+	vec2 uv = (wpos.xz - height_rect.xy) / height_rect.zw;
+	float depth = far_depth;
+	if (uv.x > 0.0 && uv.y > 0.0 && uv.x < 1.0 && uv.y < 1.0) {
+		depth = max(water_level - texture(height_tex, uv).r, 0.0);
+	}
+	float dist = length(VERTEX);
+	float t = TIME;
+	// Ondas: normal perturbada por dos capas de ruido (se aplanan a lo lejos).
+	float e = 0.35;
+	float h0 = waves(wpos.xz, t);
+	float hx = waves(wpos.xz + vec2(e, 0.0), t);
+	float hz = waves(wpos.xz + vec2(0.0, e), t);
+	float calm = 1.0 - smoothstep(60.0, 260.0, dist);
+	vec3 wn = normalize(vec3((h0 - hx) * wave_scale * 6.0 * calm, 1.0, (h0 - hz) * wave_scale * 6.0 * calm));
+	NORMAL = normalize((VIEW_MATRIX * vec4(wn, 0.0)).xyz);
+	float d01 = clamp(depth / 3.0, 0.0, 1.0);
+	vec3 col = mix(shallow_color, deep_color, smoothstep(0.0, 1.0, d01));
+	// Espuma en la orilla: bandas que avanzan y se deshacen con ruido.
+	float shore = 1.0 - smoothstep(0.0, 0.55, depth);
+	float bands = smoothstep(0.55, 0.9, sin(depth * 14.0 - t * 1.8) * 0.5 + 0.5) * (1.0 - smoothstep(0.1, 0.6, depth));
+	float foam = clamp(shore * 0.75 + bands * 0.5, 0.0, 1.0) * smoothstep(0.35, 0.65, vnoise(wpos.xz * 1.8 + t * 0.3) + shore * 0.4);
+	foam *= 1.0 - smoothstep(80.0, 180.0, dist);
+	col = mix(col, foam_color, foam);
+	float fres = pow(1.0 - clamp(dot(normalize(-VERTEX), NORMAL), 0.0, 1.0), 4.0);
+	ALBEDO = col;
+	ROUGHNESS = mix(0.06, 0.5, foam);
+	METALLIC = 0.0;
+	SPECULAR = 0.6;
+	ALPHA = clamp(mix(0.55, 0.92, d01) + fres * 0.3 + foam, 0.0, 1.0);
+}
diff --git a/tests/screenshot_graficos.gd b/tests/screenshot_graficos.gd
new file mode 100644
index 0000000..b3ab81a
--- /dev/null
+++ b/tests/screenshot_graficos.gd
@@ -0,0 +1,195 @@
+extends Node
+## Capturas del sistema gráfico (docs/GRAFICOS.md): pueblo de día, atardecer y noche, interior de
+## una casa, zona industrial (carreteras, rieles y mina) y una vista media con río y vegetación.
+## También mide el tiempo de frame promedio en cada vista (orientativo con xvfb).
+## xvfb-run -a -s "-screen 0 1600x900x24" godot --rendering-driver opengl3 res://tests/screenshot_graficos.tscn -- <carpeta> <prefijo> [calidad]
+
+var out := "user://"
+var prefix := "g"
+var world: Node3D
+var rig: CameraRig
+var perf := []
+
+
+func _pv(arr: Array) -> PackedVector2Array:
+	var o := PackedVector2Array()
+	for a in arr:
+		o.append(Vector2(float(a[0]), float(a[1])))
+	return o
+
+
+func _place(type_id: String, x: float, z: float, rot := 0.0, level := 1, tier := "normal") -> Dictionary:
+	var b: Dictionary = ConstructionSim.make_building(GameState, type_id, level, x, z, rot, "jugador")
+	if tier != "normal":
+		b["tier"] = tier
+	GameState.add_building(b)
+	return b
+
+
+func _set_hour(h: float) -> void:
+	TimeManager.total_hours += int(floor(h)) - TimeManager.hour()
+	TimeManager.hour_fraction = h - floor(h)
+
+
+func _cam(pos: Vector3, dist: float, yaw: float) -> void:
+	rig.follow = null
+	rig.target_pos = pos
+	rig.position = pos
+	rig.distance = dist
+	rig.target_distance = dist
+	rig.yaw = yaw
+	rig.target_yaw = yaw
+
+
+func _shot(name: String, frames := 45) -> void:
+	for i in range(frames):
+		await get_tree().process_frame
+	# Tiempo de frame promedio (20 frames) y carga de la escena (llamadas de dibujo, objetos, primitivas).
+	var t0 := Time.get_ticks_usec()
+	for i in range(20):
+		await get_tree().process_frame
+	var ms := float(Time.get_ticks_usec() - t0) / 20000.0
+	var calls := int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME))
+	var objs := int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME))
+	var prims := int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))
+	var nodes := int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))
+	perf.append("%s: %.1f ms/frame (~%.0f FPS) · %d draw calls · %d objetos · %d primitivas · %d nodos" % [name, ms, 1000.0 / maxf(ms, 0.01), calls, objs, prims, nodes])
+	get_viewport().get_texture().get_image().save_png("%s/%s_%s.png" % [out, prefix, name])
+	print("captura: %s_%s.png  %.1f ms/frame" % [prefix, name, ms])
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	out = args[0] if args.size() > 0 else "user://"
+	prefix = args[1] if args.size() > 1 else "g"
+	var gs = GameState
+	gs.new_game({"map_type": "rio", "seed": 2024, "difficulty": "facil"})
+	gs.suppress_notifications = true
+	gs.money = 900000.0
+	gs.weather["type"] = "despejado"
+	gs.research["era"] = 3
+	for t in ["carretas", "caminos_empedrados", "maquina_vapor", "ferrocarril", "automovil", "transporte_publico", "polvora"]:
+		if not gs.techs.has(t):
+			gs.techs.append(t)
+	gs.unlocked_zones = []
+	for x in range(gs.ZONE_GRID):
+		for y in range(gs.ZONE_GRID):
+			gs.unlocked_zones.append([x, y])
+	# Viviendas de varias épocas y calidades alrededor de la plaza.
+	var homes := [[1, "normal", -18, 12, 0.3], [1, "media", -12, 20, 0.8], [2, "normal", 16, 14, 2.6], [2, "alta", 22, 4, 2.0],
+			[3, "normal", -20, -8, 1.3], [3, "media", 12, -18, 3.4], [4, "normal", -30, 24, 0.5], [2, "media", 4, 24, 3.1],
+			[1, "alta", -6, -22, 0.2], [5, "normal", 36, -26, 0.9]]
+	var alta := {}
+	for h in homes:
+		var b := _place("vivienda", h[2], h[3], h[4], h[0], h[1])
+		if h[0] == 2 and h[1] == "alta":
+			alta = b
+	_place("taberna", -26, -2, 1.4)
+	_place("tienda", 24, -8, 4.0)
+	_place("panaderia", 8, 16, 3.3)
+	_place("iglesia", 0, -16, 0.0)
+	_place("banco", -10, 30, 3.0, 2)
+	_place("oficina", 30, 18, 2.4, 2)
+	# Zona industrial al oeste: almacén, fábricas, central y depósito de camiones.
+	_place("almacen", -54, -10, 0.0, 2)
+	_place("siderurgica", -66, 8, 1.57)
+	_place("aserradero", -46, 12, 0.2)
+	_place("central_carbon", -74, -24, 0.0)
+	_place("deposito_camiones", -44, -28, 0.4)
+	# Carreteras: cemento por el pueblo hacia la zona industrial y una rama empedrada.
+	TransitSim.build_road(gs, _pv([[-8, 0], [-30, 6], [-48, 0], [-62, -6], [-80, -8]]), "cemento")
+	TransitSim.build_road(gs, _pv([[8, 2], [26, 10], [40, 28]]), "empedrado")
+	TransitSim.build_road(gs, _pv([[-48, 0], [-50, -18], [-44, -34]]), "barro")
+	var tid := str(TradeSim.towns(gs)[0]["id"])
+	TransitSim.set_trade_path(gs, tid, _pv([[-9, 4], [-40, 26], [-80, 20], [-130, 48], [-199, 40]]))
+	TimeManager.advance_days(int(TradeSim.project(gs, tid).get("total_days", 40)) + 1)
+	_place("estacion_tren", -30, -40, 0.3)
+	TransitSim.set_trade_path(gs, tid, _pv([[-32, -48], [-60, -52], [-100, -40], [-150, -44], [-199, -30]]), true)
+	TimeManager.advance_days(int(TradeSim.connection(gs, tid)["work"]["rail"]["done_day"]) - gs.today() + 1)
+	for i in range(8):
+		gs.money = 900000.0
+		TimeManager.advance_days(1)
+	gs.weather["type"] = "despejado"
+	gs.season = "primavera"
+	world = load("res://scenes/main.tscn").instantiate()
+	add_child(world)
+	await get_tree().process_frame
+	rig = world.camera_rig
+	var terrain: Terrain = world.terrain
+	TransitVisuals.instance.rebuild()
+	# Mina de hierro sobre un yacimiento en terreno seco cerca de la zona industrial.
+	var spot := Vector2(-90, 30)
+	var best := INF
+	for x in range(-130, -60, 4):
+		for z in range(-10, 60, 4):
+			if terrain.footprint_ok(x, z, 24.0) == "" and terrain.is_land(x, z, 1.0) and Vector2(x + 90, z - 30).length() < best:
+				best = Vector2(x + 90, z - 30).length()
+				spot = Vector2(x, z)
+	gs.logistics["deposits"] = [{"id": 1, "type": "hierro", "x": spot.x, "z": spot.y, "amount": 14000.0, "initial": 14000.0, "grade": 1.1}]
+	MineSim.ensure_area(gs.logistics["deposits"][0])
+	var d: Dictionary = gs.logistics["deposits"][0]
+	var c := spot + Vector2(-6, 4)
+	var r := ConstructionSim.start_construction(gs, "mina_hierro", c.x, c.y, 0.3, "Mina La Colorada", "sas")
+	var mine: Dictionary = r.get("building", {})
+	if not mine.is_empty():
+		mine["status"] = "activo"
+		mine["level"] = 2
+		mine["target_level"] = 2
+		for p in [["tajo", 0.2, 0.62, 0.0], ["socavon", -1.9, 0.62, 2.6], ["torre_extraccion", 1.9, 0.6, -0.5]]:
+			var ang := float(p[1])
+			var pos := Vector2(float(d["x"]), float(d["z"])) + Vector2.from_angle(ang) * MineSim.radius_at(d, ang) * float(p[2])
+			MineSim.add_part(gs, mine, str(p[0]), pos.x, pos.y, float(p[3]))
+		for part in MineSim.parts(mine):
+			part["status"] = "activo"
+		EventBus.building_changed.emit(int(mine["id"]))
+		MiningVisuals.instance.rebuild_all()
+	world.hud.visible = true
+	TimeManager.set_speed(0)
+	var plaza := Vector3(0, terrain.height_at(0, 0), 0)
+	# 1) Pueblo de día.
+	_set_hour(10.0)
+	_cam(plaza, 62.0, 35.0)
+	await _shot("pueblo_dia")
+	# 2) Atardecer y noche.
+	_set_hour(18.2)
+	_cam(plaza, 62.0, 200.0)
+	await _shot("pueblo_atardecer")
+	_set_hour(21.5)
+	_cam(plaza, 55.0, 35.0)
+	await _shot("pueblo_noche")
+	# 3) Zona industrial con carreteras, rieles y mina.
+	_set_hour(11.0)
+	_cam(Vector3(-62, terrain.height_at(-62, -10), -10), 85.0, 20.0)
+	await _shot("industrial")
+	if not mine.is_empty():
+		_cam(Vector3(float(d["x"]), terrain.height_at(float(d["x"]), float(d["z"])), float(d["z"])), 45.0, 205.0)
+		await _shot("mina")
+	# 4) Vista media con río y vegetación: busca agua cerca del pueblo.
+	var river := Vector3(90, 0, 0)
+	var rbest := INF
+	for x in range(-180, 180, 6):
+		for z in range(-180, 180, 6):
+			if terrain.height_at(x, z) < terrain.water_level - 0.3:
+				var dd := Vector2(x, z).length()
+				if dd < rbest and dd > 50.0:
+					rbest = dd
+					river = Vector3(x, 0, z)
+	river.y = terrain.water_level
+	_cam(river, 48.0, 120.0)
+	await _shot("rio_vegetacion")
+	_cam(river + Vector3(-10, 0, 10), 22.0, 300.0)
+	await _shot("rio_cerca")
+	# 5) Interior de una casa.
+	_set_hour(10.0)
+	if not alta.is_empty():
+		for cz in gs.citizens.values().slice(0, 3):
+			cz.home_id = int(alta["id"])
+		EventBus.interior_requested.emit(int(alta["id"]))
+		await _shot("interior")
+	print("RENDIMIENTO (%s, %s):" % [prefix, RenderingServer.get_video_adapter_name()])
+	for l in perf:
+		print("  " + l)
+	var f := FileAccess.open("%s/%s_rendimiento.txt" % [out, prefix], FileAccess.WRITE)
+	if f:
+		f.store_string("\n".join(perf) + "\n")
+	get_tree().quit()
