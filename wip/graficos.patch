+	_quad(v, n, p[0], p[1], p[5], p[4], c)
+	_quad(v, n, p[2], p[3], p[7], p[6], c)
+	_quad(v, n, p[0], p[2], p[6], p[4], c)
+	_quad(v, n, p[1], p[3], p[7], p[5], c)
+
