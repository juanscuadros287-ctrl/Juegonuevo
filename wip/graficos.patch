+	var hh := height * 0.5
+	var inside := Vector3.ZERO
+	for i in range(segments):
+		var a0 := TAU * i / segments
+		var a1 := TAU * (i + 1) / segments
+		var d0 := Vector3(sin(a0), 0, cos(a0))
+		var d1 := Vector3(sin(a1), 0, cos(a1))
