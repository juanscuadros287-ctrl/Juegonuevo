+	var tw := c.create_tween().set_parallel(true).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
+	tw.tween_property(c, "scale", Vector2.ONE, dur)
+	tw.tween_property(c, "modulate:a", 1.0, dur * 0.8)
