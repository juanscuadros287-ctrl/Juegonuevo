+func _category_tip(cat: Dictionary) -> String:
+	var items: Array = cat["items"]
+	if items.size() == 1:
+		return "%s (%s)" % [cat["label"], items[0][3]]
+	var lines := ["%s (%s)" % [cat["label"], cat["key"]]]
+	for it in items:
+		lines.append("  • %s%s" % [it[1], "  [%s]" % it[3] if str(it[3]) != "" else ""])
+	return "\n".join(lines)
+
