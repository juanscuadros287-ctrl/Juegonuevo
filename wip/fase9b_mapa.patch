+		if (f.x < w && abs(zone_id(ci + ivec2(-1, 0)) - id) > 0.001) { e = max(e, 1.0 - f.x / w); }
+		if (f.x > 1.0 - w && abs(zone_id(ci + ivec2(1, 0)) - id) > 0.001) { e = max(e, 1.0 - (1.0 - f.x) / w); }
+		if (f.y < w && abs(zone_id(ci + ivec2(0, -1)) - id) > 0.001) { e = max(e, 1.0 - f.y / w); }
