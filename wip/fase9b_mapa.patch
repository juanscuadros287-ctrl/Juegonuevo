+	for j in range(g.size):
+		for i in range(g.size):
+			oi.set_pixel(i, j, cols[grid[j * g.size + i]])
+	if owner_texture == null:
+		owner_texture = ImageTexture.create_from_image(oi)
+	else:
+		owner_texture.update(oi)
+
