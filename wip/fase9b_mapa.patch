+		var rd := _cell_bilinear(_rdist, x, z) + _warp.get_noise_2d(x, z) * 30.0
+		var half_w := rw * 0.5 * (1.0 - town_guard)
+		var bank := 1.0 - smoothstep(half_w, half_w * 4.0, rd)
+		if bank > 0.0:
