+## Carga la rejilla del país real y la convierte a alturas del juego.
+func _setup_real() -> void:
+	var d := WorldData.country_data(country_id)
+	var g: Dictionary = d.get("grid", {})
+	_gm = int(g.get("m", 0))
+	_gx0 = float(g.get("x0", 0.0))
